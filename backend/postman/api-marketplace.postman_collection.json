{
  "info": {
    "name": "Open Banking API Marketplace",
    "description": "The full consent journey, in order. Run the folders top to bottom (or use the Collection Runner) — each request saves what the next one needs into collection variables.\n\nVariables are pre-filled for the local dev stack; change `base_url` if the backend runs elsewhere.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:4000" },
    { "key": "client_id", "value": "budgetbuddy" },
    { "key": "client_secret", "value": "budgetbuddy-secret-dev-only" },
    { "key": "redirect_uri", "value": "http://localhost:3000/callback" },
    { "key": "bank_username", "value": "ada" },
    { "key": "bank_password", "value": "password123" },
    { "key": "account_id", "value": "acct-demo-001" },
    { "key": "admin_key", "value": "dev-admin-key-change-me" },
    { "key": "session_token", "value": "" },
    { "key": "consent_id", "value": "" },
    { "key": "auth_code", "value": "" },
    { "key": "access_token", "value": "" },
    { "key": "portal_token", "value": "" },
    { "key": "app_row_id", "value": "" },
    { "key": "new_client_id", "value": "" },
    { "key": "new_client_secret", "value": "" }
  ],
  "item": [
    {
      "name": "0. Platform",
      "item": [
        {
          "name": "Health",
          "request": { "method": "GET", "url": "{{base_url}}/health" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('database and core banking are up', () => {",
            "  const b = pm.response.json();",
            "  pm.expect(b.checks.database).to.be.true;",
            "  pm.expect(b.checks.core_banking).to.be.true;",
            "});"
          ] } }]
        }
      ]
    },
    {
      "name": "1. Consent journey (the demo)",
      "item": [
        {
          "name": "1.1 Partner calls API with no token → 401",
          "request": { "method": "GET", "url": "{{base_url}}/api/v1/accounts" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('rejected with invalid_token', () => {",
            "  pm.response.to.have.status(401);",
            "  pm.expect(pm.response.json().error.code).to.eql('invalid_token');",
            "});"
          ] } }]
        },
        {
          "name": "1.2 App starts consent flow (GET /oauth/authorize)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/oauth/authorize?response_type=code&client_id={{client_id}}&redirect_uri={{redirect_uri}}&scope=accounts:read balances:read transactions:read&state=xyz123&format=json",
              "host": ["{{base_url}}"], "path": ["oauth", "authorize"],
              "query": [
                { "key": "response_type", "value": "code" },
                { "key": "client_id", "value": "{{client_id}}" },
                { "key": "redirect_uri", "value": "{{redirect_uri}}" },
                { "key": "scope", "value": "accounts:read balances:read transactions:read" },
                { "key": "state", "value": "xyz123" },
                { "key": "format", "value": "json", "description": "Return JSON instead of a 302 so Postman can read it" }
              ]
            }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('consent created', () => pm.response.to.have.status(201));",
            "pm.collectionVariables.set('consent_id', pm.response.json().consent_id);",
            "console.log('consent_id =', pm.response.json().consent_id);"
          ] } }]
        },
        {
          "name": "1.3 Customer logs in on the bank's page",
          "request": {
            "method": "POST", "url": "{{base_url}}/bank/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{bank_username}}\",\n  \"password\": \"{{bank_password}}\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('logged in', () => pm.response.to.have.status(200));",
            "pm.collectionVariables.set('session_token', pm.response.json().session_token);"
          ] } }]
        },
        {
          "name": "1.4 Consent screen data (what's requested + her accounts)",
          "request": {
            "method": "GET", "url": "{{base_url}}/bank/consents/{{consent_id}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{session_token}}" }]
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('pending consent with accounts to choose from', () => {",
            "  const b = pm.response.json();",
            "  pm.expect(b.consent.status).to.eql('awaiting_authorisation');",
            "  pm.expect(b.accounts.length).to.be.above(0);",
            "});"
          ] } }]
        },
        {
          "name": "1.5 Customer approves, selects account",
          "request": {
            "method": "POST", "url": "{{base_url}}/bank/consents/{{consent_id}}/authorise",
            "header": [
              { "key": "Authorization", "value": "Bearer {{session_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"account_ids\": [\"{{account_id}}\"]\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('authorised', () => pm.expect(pm.response.json().status).to.eql('authorised'));",
            "const code = (pm.response.json().redirect_to.match(/[?&]code=([^&]+)/) || [])[1];",
            "pm.collectionVariables.set('auth_code', code);",
            "console.log('auth code =', code);"
          ] } }]
        },
        {
          "name": "1.6 App swaps code for token (POST /oauth/token)",
          "request": {
            "method": "POST", "url": "{{base_url}}/oauth/token",
            "auth": { "type": "basic", "basic": [
              { "key": "username", "value": "{{client_id}}" },
              { "key": "password", "value": "{{client_secret}}" }
            ] },
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "grant_type", "value": "authorization_code" },
              { "key": "code", "value": "{{auth_code}}" },
              { "key": "redirect_uri", "value": "{{redirect_uri}}" }
            ] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('token issued', () => {",
            "  pm.response.to.have.status(200);",
            "  pm.expect(pm.response.json().token_type).to.eql('Bearer');",
            "});",
            "pm.collectionVariables.set('access_token', pm.response.json().access_token);"
          ] } }]
        },
        {
          "name": "1.6b Replay the same code → invalid_grant",
          "request": {
            "method": "POST", "url": "{{base_url}}/oauth/token",
            "auth": { "type": "basic", "basic": [
              { "key": "username", "value": "{{client_id}}" },
              { "key": "password", "value": "{{client_secret}}" }
            ] },
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "grant_type", "value": "authorization_code" },
              { "key": "code", "value": "{{auth_code}}" },
              { "key": "redirect_uri", "value": "{{redirect_uri}}" }
            ] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('single-use code rejected (RFC 6749 shape)', () => {",
            "  pm.response.to.have.status(400);",
            "  pm.expect(pm.response.json().error).to.eql('invalid_grant');",
            "});"
          ] } }]
        },
        {
          "name": "1.7 App reads accounts",
          "request": {
            "method": "GET", "url": "{{base_url}}/api/v1/accounts",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('only the consented account, in the public shape', () => {",
            "  const b = pm.response.json();",
            "  pm.expect(b.data).to.have.length(1);",
            "  pm.expect(b.data[0]).to.not.have.property('account_number');",
            "  pm.expect(b.data[0].account_number_masked).to.match(/^\\*{4}\\d{4}$/);",
            "});"
          ] } }]
        },
        {
          "name": "1.7 App reads balances",
          "request": {
            "method": "GET", "url": "{{base_url}}/api/v1/accounts/{{account_id}}/balances",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          },
          "event": [{ "listen": "test", "script": { "exec": [ "pm.test('200', () => pm.response.to.have.status(200));" ] } }]
        },
        {
          "name": "1.7 App reads transactions (paginated)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/accounts/{{account_id}}/transactions?limit=2",
              "host": ["{{base_url}}"], "path": ["api", "v1", "accounts", "{{account_id}}", "transactions"],
              "query": [
                { "key": "limit", "value": "2" },
                { "key": "cursor", "value": "", "disabled": true, "description": "Paste meta.pagination.next_cursor here for page 2" },
                { "key": "type", "value": "debit", "disabled": true },
                { "key": "sort", "value": "booked_at_asc", "disabled": true }
              ]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('page of 2 with a cursor', () => {",
            "  const b = pm.response.json();",
            "  pm.expect(b.data).to.have.length(2);",
            "  pm.expect(b.meta.pagination.has_more).to.be.true;",
            "});"
          ] } }]
        },
        {
          "name": "1.7b Account she did NOT share → 404",
          "request": {
            "method": "GET", "url": "{{base_url}}/api/v1/accounts/acct-demo-002",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('404, not 403 — no account-id probing', () => pm.response.to.have.status(404));"
          ] } }]
        },
        {
          "name": "1.8 Customer opens Connected Apps",
          "request": {
            "method": "GET", "url": "{{base_url}}/bank/connected-apps",
            "header": [{ "key": "Authorization", "value": "Bearer {{session_token}}" }]
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('BudgetBuddy is listed as authorised', () => {",
            "  const c = pm.response.json().data.find(x => x.id === pm.collectionVariables.get('consent_id'));",
            "  pm.expect(c.status).to.eql('authorised');",
            "});"
          ] } }]
        },
        {
          "name": "1.8 Customer revokes",
          "request": {
            "method": "POST", "url": "{{base_url}}/bank/connected-apps/{{consent_id}}/revoke",
            "header": [{ "key": "Authorization", "value": "Bearer {{session_token}}" }]
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('revoked', () => pm.expect(pm.response.json().status).to.eql('revoked'));"
          ] } }]
        },
        {
          "name": "1.9 App's next call fails instantly",
          "request": {
            "method": "GET", "url": "{{base_url}}/api/v1/accounts",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('403 consent_revoked with an unexpired token', () => {",
            "  pm.response.to.have.status(403);",
            "  pm.expect(pm.response.json().error.code).to.eql('consent_revoked');",
            "});"
          ] } }]
        }
      ]
    },
    {
      "name": "2. Analytics (control room)",
      "auth": { "type": "apikey", "apikey": [
        { "key": "key", "value": "X-Admin-Key" },
        { "key": "value", "value": "{{admin_key}}" },
        { "key": "in", "value": "header" }
      ] },
      "item": [
        { "name": "Summary", "request": { "method": "GET", "url": "{{base_url}}/analytics/summary?window=24h" } },
        { "name": "Calls per client", "request": { "method": "GET", "url": "{{base_url}}/analytics/calls-per-client" } },
        { "name": "Timeseries", "request": { "method": "GET", "url": "{{base_url}}/analytics/timeseries?window=24h" } },
        { "name": "Recent calls (live feed)", "request": { "method": "GET", "url": "{{base_url}}/analytics/recent-calls?limit=20" } },
        { "name": "Consents by status", "request": { "method": "GET", "url": "{{base_url}}/analytics/consents" } },
        {
          "name": "Without admin key → 401",
          "request": { "method": "GET", "url": "{{base_url}}/analytics/summary", "auth": { "type": "noauth" } },
          "event": [{ "listen": "test", "script": { "exec": [ "pm.test('401', () => pm.response.to.have.status(401));" ] } }]
        }
      ]
    },
    {
      "name": "3. Developer portal",
      "item": [
        {
          "name": "3.1 Sign up (or log in if the email exists)",
          "request": {
            "method": "POST", "url": "{{base_url}}/portal/signup",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"postman-dev@example.com\",\n  \"password\": \"portal-password-123\",\n  \"name\": \"Postman Developer\",\n  \"company\": \"Postman Ltd\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "if (pm.response.code === 201) {",
            "  pm.collectionVariables.set('portal_token', pm.response.json().portal_token);",
            "} else {",
            "  // email already registered from a previous run — log in instead",
            "  pm.sendRequest({",
            "    url: pm.collectionVariables.get('base_url') + '/portal/login', method: 'POST',",
            "    header: { 'Content-Type': 'application/json' },",
            "    body: { mode: 'raw', raw: JSON.stringify({ email: 'postman-dev@example.com', password: 'portal-password-123' }) }",
            "  }, (err, res) => pm.collectionVariables.set('portal_token', res.json().portal_token));",
            "}",
            "pm.test('have a portal token', () => pm.expect([200, 201, 409]).to.include(pm.response.code));"
          ] } }]
        },
        {
          "name": "3.2 Register an app (secret shown ONCE)",
          "request": {
            "method": "POST", "url": "{{base_url}}/portal/apps",
            "header": [
              { "key": "Authorization", "value": "Bearer {{portal_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Postman Test App\",\n  \"description\": \"Registered from Postman\",\n  \"redirect_uris\": [\"{{redirect_uri}}\"]\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('created with credentials', () => pm.response.to.have.status(201));",
            "const b = pm.response.json();",
            "pm.collectionVariables.set('app_row_id', b.id);",
            "pm.collectionVariables.set('new_client_id', b.client_id);",
            "pm.collectionVariables.set('new_client_secret', b.client_secret);",
            "console.log('new client:', b.client_id, b.client_secret);"
          ] } }]
        },
        {
          "name": "3.3 List my apps",
          "request": {
            "method": "GET", "url": "{{base_url}}/portal/apps",
            "header": [{ "key": "Authorization", "value": "Bearer {{portal_token}}" }]
          }
        },
        {
          "name": "3.4 Rotate secret",
          "request": {
            "method": "POST", "url": "{{base_url}}/portal/apps/{{app_row_id}}/rotate-secret",
            "header": [{ "key": "Authorization", "value": "Bearer {{portal_token}}" }]
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.collectionVariables.set('new_client_secret', pm.response.json().client_secret);"
          ] } }]
        },
        {
          "name": "3.5 Deactivate app (blast-radius switch)",
          "request": {
            "method": "POST", "url": "{{base_url}}/portal/apps/{{app_row_id}}/deactivate",
            "header": [{ "key": "Authorization", "value": "Bearer {{portal_token}}" }]
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('deactivated and consents revoked', () => {",
            "  pm.expect(pm.response.json().status).to.eql('deactivated');",
            "  pm.expect(pm.response.json()).to.have.property('consents_revoked');",
            "});"
          ] } }]
        }
      ]
    }
  ]
}
