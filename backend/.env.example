# HTTP
PORT=4000
NODE_ENV=development
LOG_LEVEL=debug

# Postgres (marketplace schema: clients, consents, api call log)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/marketplace

# JWT signing (HS256). Generate a long random string for anything beyond local dev.
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_SECONDS=86400
AUTH_CODE_TTL_SECONDS=300
CONSENT_TTL_DAYS=90
# How long a customer has to act on a consent request before it expires
CONSENT_REQUEST_TTL_MINUTES=15
# Demo customer whose accounts back developer sandbox tokens
SANDBOX_CUSTOMER_ID=customer-demo-001
# The seeded sample fintech app. /demo/* acts as that app's own backend so the browser
# never holds its client secret. Disabled when NODE_ENV=production.
DEMO_CLIENT_ID=budgetbuddy
# Host the sample app's stand-in backend. Off in any real deployment.
DEMO_SAMPLE_APP=true
# Bank login lockout
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# Where the bank consent UI lives (frontend). /oauth/authorize redirects the customer here.
CONSENT_UI_URL=http://localhost:3000/consent
# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Mock core banking service (Go)
CORE_BANKING_URL=http://localhost:8081
CORE_BANKING_API_KEY=mockcore-api-key
# Set to "memory" to run without the Go service (small in-memory dataset, used by tests)
CORE_BANKING_ADAPTER=http

# Analytics dashboard auth. Sent as the X-Admin-Key header on /analytics/*.
ADMIN_KEY=local-demo-admin-key-5d1b73c6

# Per-client quota on /api/v1/*. Keyed by client_id from the access token, not IP.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
# Per-IP limit (same window) on /oauth/* and /bank/login
PUBLIC_RATE_LIMIT_MAX=30
